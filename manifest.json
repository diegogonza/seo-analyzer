{
  "manifest_version": 3,
  "name": "SEO Headings",
  "version": "1.1",
  "description": "Highlight all H1-H6 headings on the page.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  }
}
